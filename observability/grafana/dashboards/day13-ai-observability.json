  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus-day13"},
      "description": "P50, P95 and P99 latency. Contract source event: response_sent.latency_ms. SLO: P95 <= 3000 ms.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Latency",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 8,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "line"}
          },
          "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 3000}]},
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {"h": 9, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"editorMode": "code", "expr": "histogram_quantile(0.50, sum by (le) (rate(day13_ai_request_latency_seconds_bucket[$__rate_interval]))) * 1000", "legendFormat": "P50", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(day13_ai_request_latency_seconds_bucket[$__rate_interval]))) * 1000", "legendFormat": "P95", "range": true, "refId": "B"},
        {"editorMode": "code", "expr": "histogram_quantile(0.99, sum by (le) (rate(day13_ai_request_latency_seconds_bucket[$__rate_interval]))) * 1000", "legendFormat": "P99", "range": true, "refId": "C"}
      ],
      "title": "Latency percentiles",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus-day13"},
      "description": "Request count converted to requests per minute. Contract source event: request_received.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "Traffic", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "bars", "fillOpacity": 24, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "insertNulls": false, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 4, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": true, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "line"}},
          "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]},
          "unit": "reqpm"
        },
        "overrides": []
      },
      "gridPos": {"h": 9, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "options": {"legend": {"calcs": ["lastNotNull", "mean"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "single", "sort": "none"}},
      "targets": [
        {"editorMode": "code", "expr": "sum(rate(day13_ai_requests_total[$__rate_interval])) * 60", "legendFormat": "requests/min", "range": true, "refId": "A"}
      ],
      "title": "Request traffic",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus-day13"},
      "description": "Overall error percentage plus per-error-type occurrence rate. SLO: error rate <= 2%.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "Errors", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 8, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "insertNulls": false, "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 4, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": true, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "line"}},
          "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 2}]},
          "unit": "percent"
        },
        "overrides": [{"matcher": {"id": "byRegexp", "options": "/errors\/min/"}, "properties": [{"id": "unit", "value": "reqpm"}]}]
      },
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [
        {"editorMode": "code", "expr": "100 * sum(rate(day13_ai_requests_total{status=\"error\"}[$__rate_interval])) / clamp_min(sum(rate(day13_ai_requests_total[$__rate_interval])), 0.000001)", "legendFormat": "error rate", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "sum by (error_type) (rate(day13_ai_errors_total[$__rate_interval])) * 60", "legendFormat": "{{error_type}} errors/min", "range": true, "refId": "B"}
      ],
      "title": "Error rate and breakdown",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus-day13"},
      "description": "Estimated model cost accumulated per minute. Budget threshold: USD 2.50.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "continuous-GrYlRd"},
          "custom": {"axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "Cost per minute", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 18, "gradientMode": "opacity", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "insertNulls": false, "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 4, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": true, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "line"}},
          "decimals": 4,
          "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 2.5}]},
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {"h": 9, "w": 8, "x": 0, "y": 9},
      "id": 4,
      "options": {"legend": {"calcs": ["lastNotNull", "sum"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "single", "sort": "none"}},
      "targets": [
        {"editorMode": "code", "expr": "sum(rate(day13_ai_cost_usd_total[$__rate_interval])) * 60", "legendFormat": "USD/min", "range": true, "refId": "A"}
      ],
      "title": "Cost over time",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus-day13"},
      "description": "Input and output token throughput derived from response_sent.tokens_in/tokens_out.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "Tokens per minute", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "insertNulls": false, "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 4, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": true, "stacking": {"group": "A", "mode": "normal"}, "thresholdsStyle": {"mode": "line"}},
          "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 50000}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 9, "w": 8, "x": 8, "y": 9},
      "id": 5,
      "options": {"legend": {"calcs": ["lastNotNull", "sum"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [
        {"editorMode": "code", "expr": "sum by (direction) (rate(day13_ai_tokens_total[$__rate_interval])) * 60", "legendFormat": "{{direction}}", "range": true, "refId": "A"}
      ],
      "title": "Input and output tokens",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus-day13"},
      "description": "Mean heuristic quality score over the active query interval. SLO: mean >= 0.75.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "continuous-RdYlGr"},
          "custom": {"axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "Quality score", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 18, "gradientMode": "opacity", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "insertNulls": false, "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 4, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": true, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "line"}},
          "decimals": 2,
          "max": 1,
          "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.75}]},
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 9},
      "id": 6,
      "options": {"legend": {"calcs": ["lastNotNull", "mean"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "single", "sort": "none"}},
      "targets": [
        {"editorMode": "code", "expr": "sum(rate(day13_ai_quality_score_sum[$__rate_interval])) / clamp_min(sum(rate(day13_ai_quality_score_count[$__rate_interval])), 0.000001)", "legendFormat": "mean quality", "range": true, "refId": "A"}
      ],
      "title": "Quality proxy",
