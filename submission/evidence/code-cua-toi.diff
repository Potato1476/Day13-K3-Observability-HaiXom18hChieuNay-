+def test_every_contract_metric_is_registered_in_the_app() -> None:
+    """Dashboard và alert chỉ được tham chiếu series mà app thực sự export."""
+    exposition = generate_latest().decode("utf-8")
+    registered = {family.name for family in text_string_to_metric_families(exposition)}
+
+    for metric in EXPORTED_METRICS:
+        # Parser bỏ hậu tố _total của counter khi đặt tên family.
+        assert metric in registered or metric.removesuffix("_total") in registered
+
+
+def test_is_exported_metric_accepts_histogram_sample_names() -> None:
+    assert is_exported_metric("day13_ai_request_latency_seconds_bucket")
+    assert is_exported_metric("day13_ai_quality_score_sum")
+    assert is_exported_metric("day13_ai_quality_score_count")
+    assert not is_exported_metric("day13_ai_request_latency_second_bucket")
+    assert not is_exported_metric("http_requests_total")
+
+
+def test_error_is_counted_in_both_numerator_and_denominator() -> None:
+    """Error rate là một tỉ lệ: một request lỗi vẫn phải làm tăng mẫu số."""
+    before = generate_latest().decode("utf-8")
+    record_error("TimeoutError", feature="qa")
+    after = generate_latest().decode("utf-8")
+
+    def sample(exposition: str, name: str, **labels: str) -> float:
+        return sum(
+            s.value
+            for family in text_string_to_metric_families(exposition)
+            for s in family.samples
+            if s.name == name
+            and all(s.labels.get(k) == v for k, v in labels.items())
+        )
+
+    assert (
+        sample(after, "day13_ai_requests_total", feature="qa", status="error")
+        - sample(before, "day13_ai_requests_total", feature="qa", status="error")
+        == 1
+    )
+    assert (
+        sample(after, "day13_ai_errors_total", feature="qa", error_type="TimeoutError")
+        - sample(before, "day13_ai_errors_total", feature="qa", error_type="TimeoutError")
+        == 1
+    )
