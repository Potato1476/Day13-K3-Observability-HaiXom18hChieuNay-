+# Contract giữa app và dashboard: đây là toàn bộ tên series mà dashboard và alert
+# được phép tham chiếu. Histogram/Summary còn sinh thêm sample _bucket, _sum và
+# _count từ cùng một tên gốc. scripts/validate_dashboard.py đối chiếu lại danh
+# sách này nên PromQL gõ sai tên metric sẽ bị bắt trước khi lên Grafana.
+EXPORTED_METRICS = frozenset(
+    {
+        "day13_ai_requests_total",
+        "day13_ai_request_latency_seconds",
+        "day13_ai_errors_total",
+        "day13_ai_tokens_total",
+        "day13_ai_cost_usd_total",
+        "day13_ai_quality_score",
+    }
+)
+_HISTOGRAM_SUFFIXES = ("_bucket", "_sum", "_count")
+
+
+def is_exported_metric(name: str) -> bool:
+    if name in EXPORTED_METRICS:
+        return True
+    return any(
+        name.endswith(suffix) and name[: -len(suffix)] in EXPORTED_METRICS
+        for suffix in _HISTOGRAM_SUFFIXES
+    )
+
 
 def _metric_feature(feature: str) -> str:
     """Keep metric label cardinality bounded and prevent PII in label values."""
