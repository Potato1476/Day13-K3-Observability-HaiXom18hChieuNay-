          "showLegend": true,
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "day13-prometheus"
          },
          "expr": "sum(rate(ai_cost_usd_total[1m])) * 60",
          "legendFormat": "USD/min",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "day13-prometheus"
          },
          "expr": "sum(increase(ai_cost_usd_total[1h]))",
          "legendFormat": "Total USD (1h)",
          "range": true
        }
      ]
    },
    {
      "id": 5,
