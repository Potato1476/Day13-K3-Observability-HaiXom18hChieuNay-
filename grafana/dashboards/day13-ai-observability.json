          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "day13-prometheus"
          },
          "expr": "sum(increase(ai_tokens_total[1h]))",
          "legendFormat": "Total tokens (1h)",
          "range": true
